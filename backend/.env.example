# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Local:  mongodb://localhost:27017/sufra
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net/sufra
MONGO_URI=mongodb://localhost:27017/sufra

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5173
